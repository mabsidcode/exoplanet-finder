# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Data and caches (regenerate with the documented commands)
data/*
!data/catalog/
!data/splits/
data/catalog/*
!data/catalog/dr24_tce_snapshot.csv
!data/catalog/dr24_tce_snapshot.provenance.json
