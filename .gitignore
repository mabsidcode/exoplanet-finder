# Model checkpoints: only the released demo bundle is committed
models/*
!models/release/
models/release/*
!models/release/*.pt
!models/release/*.joblib
!models/release/*.json

# Run artefacts
runs/
reports/figures/*.html

# OS / editors
.DS_Store
.idea/
.vscode/
.remember/

# Smoke-run reports are regenerated locally and not meaningful results
reports/quickstart/

# Demo video: recordings, intermediate frames and the exported video are local only
demo_video/build/
demo_video/*.mp4
demo_video/*.mov
demo_video/streamlit_8650.log
